#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    long long omega;
    cin >> n >> omega;

    vector<pair<long long, int>> holes(n);
    for (int i = 0; i < n; i++) {
        cin >> holes[i].first;
        holes[i].second = i + 1;
    }

    sort(holes.begin(), holes.end());

    vector<int> ans;
    long long mass = omega;

    int left = 0;
    bool possible = true;

    while (left < n) {
        int right = left;
        while (right < n && holes[right].first < mass) {
            right++;
        }

        if (left == right) {
            possible = false;
            break;
        }

        for (int i = left; i < right; i++) {
            ans.push_back(holes[i].second);
            mass += holes[i].first;
        }

        left = right;
    }

    if (!possible) {
        cout << "NO\n";
    } else {
        cout << "YES\n";
        for (int i = 0; i < ans.size(); i++) {
            cout << ans[i] << " ";
        }
        cout << "\n";
    }

    return 0;
}