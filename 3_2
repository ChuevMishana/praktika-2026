#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;
    vector<int> a(N);
    for (int i = 0; i < N; i++) {
        cin >> a[i];
    }
    sort(a.begin(), a.end());

    long long ans = 0;
    for (int i = 0; i < N - 2; i++) {
        int k = i + 2;
        for (int j = i + 1; j < N - 1; j++) {
            while (k < N && a[i] + a[j] > a[k]) {
                k++;
            }
            if (k > j + 1) {
                ans += k - j - 1;
            }
        }
    }

    cout << ans << '\n';
    return 0;
}