#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int N;
    cin >> N;

    vector<long long> cards(N);
    for (int i = 0; i < N; i++) {
        cin >> cards[i];
    }

    sort(cards.begin(), cards.end());

    long long A = cards[0];
    bool good = true;

    for (int i = 0; i < N; i++) {
        if (cards[i] != A + i) {
            good = false;
            break;
        }
    }

    if (good) {
        cout << "Deck looks good\n";
    } else {
        cout << "Scammed\n";
    }

    return 0;
}